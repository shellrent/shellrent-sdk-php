{
    "name": "shellrent/sdk",
    "description": "Official PHP SDK for the Shellrent public API",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "shellrent",
        "api",
        "sdk",
        "client",
        "hosting",
        "domains",
        "openapi"
    ],
    "homepage": "https://github.com/shellrent/shellrent-sdk-php",
    "support": {
        "issues": "https://github.com/shellrent/shellrent-sdk-php/issues",
        "source": "https://github.com/shellrent/shellrent-sdk-php"
    },
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "composer-runtime-api": "^2",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0",
        "psr/simple-cache": "^1 || ^2 || ^3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.5 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Shellrent\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shellrent\\Sdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
